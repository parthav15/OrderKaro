generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  phone        String
  isVerified   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurants  Restaurant[]
}

model Restaurant {
  id              String   @id @default(uuid())
  ownerId         String
  owner           Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  slug            String   @unique
  description     String?
  logoUrl         String?
  bannerUrl       String?
  address         String?
  phone           String?
  isActive        Boolean  @default(true)
  openingTime     String   @default("08:00")
  closingTime     String   @default("22:00")
  avgPrepTime     Int      @default(15)
  maxActiveOrders Int      @default(50)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan           Plan      @default(FREE)
  planValidUntil DateTime?

  country           String  @default("IN")
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)

  primaryColor String    @default("#DC2626")
  themeMode    ThemeMode @default(LIGHT)

  latitude         Float?
  longitude        Float?
  deliveryEnabled  Boolean @default(false)
  deliveryRadiusKm Float   @default(3)
  deliveryFee      Decimal @default(0) @db.Decimal(10, 2)
  minOrderValue    Decimal @default(0) @db.Decimal(10, 2)

  staff          Staff[]
  categories     Category[]
  tables         Table[]
  orders         Order[]
  announcements  Announcement[]
  subscriptions  Subscription[]
  menuViews      MenuView[]
  modelRequests  ModelRequest[]
  paymentAccount RestaurantPaymentAccount?
  wallets        Wallet[]

  @@map("Canteen")
}

model RestaurantPaymentAccount {
  id           String     @id @default(uuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  status   PaymentAccountStatus @default(PENDING)

  paypurKeyCipher  String?
  paypurSaltCipher String?

  stripeKeyCipher String?

  stripeAccountId        String? @unique
  stripeChargesEnabled   Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)

  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([provider, status])
}

model Subscription {
  id                String             @id @default(uuid())
  restaurantId      String
  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan              Plan
  status            SubscriptionStatus @default(PENDING)
  amount            Decimal            @db.Decimal(10, 2)
  currency          String             @default("INR")
  periodStart       DateTime?
  periodEnd         DateTime?
  provider          PaymentProvider?
  providerOrderId   String?            @unique
  providerTxnId     String?
  redirectUrl       String?
  razorpayOrderId   String?            @unique
  razorpayPaymentId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([restaurantId, status])
}

model MenuView {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   String?
  menuItem     MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sessionId    String
  source       String?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
  @@index([menuItemId, createdAt])
}

model ModelRequest {
  id           String             @id @default(uuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  status       ModelRequestStatus @default(PENDING)
  notes        String?
  resultUrl    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([restaurantId, status])
  @@index([status, createdAt])
}

model Staff {
  id           String     @id @default(uuid())
  restaurantId String     @map("canteenId")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  pin          String?
  name         String
  role         StaffRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, email])
  @@index([restaurantId, isActive])
  @@index([restaurantId, pin])
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String     @map("canteenId")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  imageUrl     String?
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]

  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id               String   @id @default(uuid())
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  imageUrl         String?
  isVeg            Boolean  @default(true)
  isAvailable      Boolean  @default(true)
  prepTimeMin      Int?
  sortOrder        Int      @default(0)
  tags             String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  model3dUrl       String?
  model3dPosterUrl String?

  customizations Customization[]
  orderItems     OrderItem[]
  menuViews      MenuView[]
  modelRequests  ModelRequest[]

  @@index([categoryId, sortOrder])
}

model Customization {
  id         String                @id @default(uuid())
  menuItemId String
  menuItem   MenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  type       CustomizationType
  isRequired Boolean               @default(false)
  minSelect  Int                   @default(0)
  maxSelect  Int                   @default(1)
  options    CustomizationOption[]
}

model CustomizationOption {
  id              String        @id @default(uuid())
  customizationId String
  customization   Customization @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  name            String
  priceAdjustment Decimal       @default(0) @db.Decimal(10, 2)
  isDefault       Boolean       @default(false)
  sortOrder       Int           @default(0)
}

model Table {
  id           String     @id @default(uuid())
  restaurantId String     @map("canteenId")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  qrCodeUrl    String?
  qrToken      String     @unique @default(uuid())
  isActive     Boolean    @default(true)
  section      String?
  posX         Float?
  posY         Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]

  @@unique([restaurantId, label])
}

model Consumer {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique
  passwordHash String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  wallets      Wallet[]
  orders       Order[]
  deviceTokens DeviceToken[]
}

model PhoneVerification {
  id         String   @id @default(uuid())
  phone      String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DeviceToken {
  id         String   @id @default(uuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())

  @@index([consumerId])
}

model Wallet {
  id           String              @id @default(uuid())
  consumerId   String
  consumer     Consumer            @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]

  @@unique([consumerId, restaurantId])
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String
  wallet        Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTransactionType
  amount        Decimal                 @db.Decimal(10, 2)
  balanceBefore Decimal                 @db.Decimal(10, 2)
  balanceAfter  Decimal                 @db.Decimal(10, 2)
  source        WalletTransactionSource
  description   String?
  reference     String?
  approvedBy    String?
  status        WalletRequestStatus     @default(APPROVED)
  createdAt     DateTime                @default(now())

  @@index([walletId, createdAt])
  @@index([status, source])
}

model Order {
  id                  String           @id @default(uuid())
  orderNumber         Int
  restaurantId        String           @map("canteenId")
  restaurant          Restaurant       @relation(fields: [restaurantId], references: [id])
  tableId             String?
  table               Table?           @relation(fields: [tableId], references: [id])
  orderType           OrderType        @default(DINE_IN)
  deliveryLocation    String?
  deliveryLatitude    Float?
  deliveryLongitude   Float?
  deliveryDistanceKm  Float?
  deliveryFee         Decimal?         @db.Decimal(10, 2)
  consumerId          String
  consumer            Consumer         @relation(fields: [consumerId], references: [id])
  status              OrderStatus      @default(PLACED)
  totalAmount         Decimal          @db.Decimal(10, 2)
  specialInstructions String?
  estimatedReadyAt    DateTime?
  paymentStatus       PaymentStatus    @default(PENDING)
  paymentMethod       PaymentMethod
  walletTransactionId String?
  paymentProvider     PaymentProvider?
  paymentOrderId      String?
  paymentTxnId        String?
  paymentRedirectUrl  String?
  platformFee         Decimal?         @db.Decimal(10, 2)
  paidAt              DateTime?
  idempotencyKey      String?          @unique
  trackingToken       String?          @unique
  placedAt            DateTime         @default(now())
  acceptedAt          DateTime?
  preparingAt         DateTime?
  readyAt             DateTime?
  pickedUpAt          DateTime?
  cancelledAt         DateTime?
  items               OrderItem[]
  statusLogs          OrderStatusLog[]

  @@index([restaurantId, status])
  @@index([restaurantId, placedAt])
  @@index([consumerId, placedAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(10, 2)
  selectedOptions Json     @default("[]")
  notes           String?
}

model OrderStatusLog {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedBy  String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

model Announcement {
  id           String     @id @default(uuid())
  restaurantId String     @map("canteenId")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  message      String
  isActive     Boolean    @default(true)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, isActive])
}

enum StaffRole {
  MANAGER
  KITCHEN
  COUNTER
}

enum Plan {
  FREE
  BASIC
  PRO
}

enum ThemeMode {
  LIGHT
  DARK
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  FAILED
}

enum ModelRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum CustomizationType {
  SINGLE_SELECT
  MULTI_SELECT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentProvider {
  PAYPUR
  STRIPE
}

enum PaymentAccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  WALLET
  ONLINE
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionSource {
  CASH_DEPOSIT
  BANK_TRANSFER
  ORDER_PAYMENT
  REFUND
  ONLINE
}

enum WalletRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
