{
  "expo": {
    "name": "Vision Menu",
    "slug": "vision-menu",
    "scheme": "visionmenu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#141110",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visionmenu.app"
    },
    "android": {
      "package": "com.visionmenu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7A1626"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        { "cameraPermission": "Allow Vision Menu to scan table QR codes." }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#141110"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://order-karo-frontend.vercel.app"
    }
  }
}
