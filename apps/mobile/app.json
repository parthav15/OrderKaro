{
  "expo": {
    "name": "Vision Menu",
    "slug": "vision-menu",
    "scheme": "visionmenu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#141110",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.visionmenu.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.visionmenu.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7A1626"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vision Menu to scan table QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141110"
        }
      ],
      "./plugins/without-push-entitlement.js",
      "./plugins/with-development-team.js",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Vision Menu to use your location to set your delivery address."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://visionmenu.app",
      "router": {},
      "eas": {
        "projectId": "f57924bc-3d82-4dcc-9d41-0f8bb79241cb"
      }
    },
    "owner": "parthav15"
  }
}
